<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlDiagnosticoMcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cifrado de secretos propio de AgenteAnalista (mismo mecanismo que DragonfishApiMcp) — el
         login SQL de solo lectura de cada perfil se guarda cifrado, nunca en texto plano. -->
    <ProjectReference Include="..\..\Shared\Secrets\AgenteAnalista.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.secrets.enc vive en la raíz del repo (un solo archivo compartido por todos
         los MCPs que necesiten secretos). Condition="Exists(...)" a propósito: si todavía no
         existe (primera vez, antes de correr "agregar-perfil" de cualquier MCP), el build no
         debe fallar por esto. -->
    <Content Include="..\..\appsettings.secrets.enc" CopyToOutputDirectory="PreserveNewest" Link="appsettings.secrets.enc" Condition="Exists('..\..\appsettings.secrets.enc')" />
  </ItemGroup>
</Project>
