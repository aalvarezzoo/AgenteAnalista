<?xml version="1.0" encoding="utf-8"?>
<!-- Todos los paquetes de este repo son públicos (ModelContextProtocol, Microsoft.Extensions.*,
     Microsoft.Data.SqlClient). Los feeds privados de ZooLogic (Nexus/Azure DevOps) no los tienen
     y devuelven 401 sin este override, lo que aborta el restore entero. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
